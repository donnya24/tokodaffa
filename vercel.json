{
  "builds": [
    {
      "src": "api/*.php",
      "use": "@vercel/php"
    },
    {
      "src": "singnduetoko/**/*.php",
      "use": "@vercel/php"
    },
    {
      "src": "*.php",
      "use": "@vercel/php"
    },
    {
      "src": "src/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/singnduetoko/(.*)",
      "dest": "/singnduetoko/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ],
  "buildCommand": "bash vercel.sh"
}
