{
  "build": {
    "builder": "NIXPACKS",
    "nixPkgs": ["php80Extensions.pdo_pgsql", "php80Extensions.pgsql"],
    "config": {
      "php_fallback_path": "/index.php",
      "php_index_path": "/singnduetoko/index.php"
    }
  },
  "deploy": {
    "include": [
      "src/assets/**/*",
      "singnduetoko/**/*",
      "api/**/*",
      "*.php",
      "composer.json"
    ],
    "startCommand": "php -S 0.0.0.0:$PORT -t ."
  }
}
