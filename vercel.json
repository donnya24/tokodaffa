{
  "builds": [
    {
      "src": "api/*.php",
      "use": "@vercel/php",
      "config": {
        "runtime": "vercel-php@0.6.0"
      }
    },
    {
      "src": "singnduetoko/*.php",
      "use": "@vercel/php",
      "config": {
        "runtime": "vercel-php@0.6.0"
      }
    },
    {
      "src": "*.php",
      "use": "@vercel/php",
      "config": {
        "runtime": "vercel-php@0.6.0"
      }
    },
    {
      "src": "src/assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.php"
    }
  ],
  "buildCommand": "bash vercel.sh"
}
